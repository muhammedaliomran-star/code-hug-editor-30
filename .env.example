# Local development only — copy to `.env` and fill real values.
# NEVER commit real secrets (`.env` is git-ignored).
#
# Where each consumer reads from:
# - Browser bundle : VITE_SUPABASE_URL + VITE_SUPABASE_PUBLISHABLE_KEY (baked at build/dev start)
# - Deployed app   : Lovable Cloud Supabase connection, with public/app-config.json as fallback
# - Server runtime : SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (never expose the service key to the browser)

VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_paste_here

SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_paste_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_paste_here__server_only
SUPABASE_PROJECT_ID=xyzcompany
